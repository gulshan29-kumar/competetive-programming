import java.util.*;
 
public class god{    public static void main(String[] args) {
        Scanner in = new Scanner(System.in);
        int t = in.nextInt();
        while (t-- > 0) {
            int n = in.nextInt();   // length of string
            int x = in.nextInt();   // Hamid's position (1-based)
            String str = in.next();
 
            if (x == 1 || x == n) {   // if Hamid is at an end
                System.out.println(1);
                continue;
            }
            x--; // make 0-based
 
            int lf = -1000000000, rg = 1000000000;
 
            // nearest left wall
            for (int i = x - 1; i >= 0; i--) {
                if (str.charAt(i) == '#') {
                    lf = i;
                    break;
                }
            }
 
            // nearest right wall
            for (int i = x + 1; i < n; i++) {
                if (str.charAt(i) == '#') {
                    rg = i;
                    break;
                }
            }
 
            // no wall case
            if (lf == -1000000000 && rg == 1000000000) {
                System.out.println(1);
                continue;
            }
 
            int ans = Math.min(x + 1, n - rg + 1);
            int ans1 = Math.min(lf + 2, n - x);
 
            System.out.println(Math.max(ans, ans1));
        }
    }
}