#include <bits/stdc++.h>
using namespace std;
 
int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t-->0){
	    string str;
	    cin>>str;
	    int sum1=0;
	    int sum2=0;
	    int a=str.size();
	    for(int i=0;i<3;i++){
	        sum1+=(str[i]-'0');
	        sum2+=(str[a-i-1]-'0');
	    }
	    if(sum1==sum2) cout<<"Yes"<<endl;
	    else cout<<"No"<<endl;
	}
 
}