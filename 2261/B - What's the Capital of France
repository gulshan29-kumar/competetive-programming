#include <bits/stdc++.h>
using namespace std;
 
int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int a;
	    cin>>a;
	    long long arr[a];
	    for(int i=0;i<a;i++) cin>>arr[i];
	    sort(arr,arr+a);
	    int arr1[100];
	    memset(arr1,0,sizeof(arr1));
	    long long maxi=arr[a-1];
	    int cnt=0;
	    long long ans=maxi;
	    long long lastbit=0;
	    while(cnt<100){
	        if(maxi&(1LL<<cnt)) arr1[cnt]=1;
	        if(maxi>=(1LL<<cnt)) lastbit=cnt;
	        cnt++;
	    }
	    arr1[lastbit]=1;
	    
	    for(int i=a-2;i>=0;i--){
	        int maxi2=arr[i];
	        for(int j=lastbit;j>=0;j--){
	            if(arr1[j]==1) continue;
	            if((maxi2|(1LL<<j))<=arr[a-1]){
	                maxi2=(maxi2|(1LL<<j));
	                arr1[j]=1;
	            }
	        }
	        ans=(ans|maxi2);
	    }
	    cout<<ans<<endl;
	}
 
}